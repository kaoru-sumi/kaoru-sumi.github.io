<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Edited Conference Proceedings (full editor names)</title>
    <id>https://kaoru-sumi.github.io/assets/csl/edited-proceedings.csl</id>
    <link href="https://kaoru-sumi.github.io/assets/csl/edited-proceedings.csl" rel="self"/>
    <updated>2026-10-02T00:00:00+00:00</updated>
  </info>
  <citation>
    <layout>
      <text variable="title"/>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <text variable="title" font-weight="bold" display="block"/>
      <names variable="editor" display="block">
        <name initialize="false" and="text" delimiter=", " delimiter-precedes-last="always"/>
        <label form="short" prefix=" (" suffix=")"/>
      </names>
      <group delimiter=", " display="block">
        <text variable="collection-title"/>
        <text variable="volume" prefix="vol. "/>
        <text variable="publisher"/>
        <date variable="issued"><date-part name="year"/></date>
      </group>
    </layout>
  </bibliography>
</style>
